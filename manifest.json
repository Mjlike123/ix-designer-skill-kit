{
  "name": "ix-designer-skill-kit",
  "version": "1.0.0",
  "entrySkill": "ix-designer-core",
  "description": "Portable PRD-to-UX/UI Agent Skill with configurable business profiles and Agent-platform adapters.",
  "license": "Proprietary",
  "requiredComposition": {
    "core": "ix-designer-core",
    "businessProfile": "<business>-profile",
    "agentAdapter": "<agent>-adapter"
  },
  "contents": {
    "core": ".agents/skills/ix-designer-core/",
    "includedAdapters": [
      ".agents/skills/cursor-adapter/"
    ],
    "profileTemplate": "templates/business-profile/"
  },
  "compatibility": {
    "cursor": "included",
    "otherAgentPlatforms": "requires adapter implementing agent-adapter.schema.yaml"
  }
}
